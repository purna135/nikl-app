{
  "name": "nikl",
  "private": true,
  "description": "Nikl: events, activities and clubs in your city. Monorepo for the mobile app, web app, shared packages and database.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nikl/web dev",
    "dev:mobile": "pnpm --filter @nikl/mobile start",
    "dev:mobile:go": "pnpm --filter @nikl/mobile start:go",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "supabase": "^2.20.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
