# Copy the values you need into:
#   apps/web/.env.local     (web)
#   apps/mobile/.env        (mobile)
# Never commit real keys. Only the public "publishable" (anon) key belongs in the apps.

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_MAPBOX_TOKEN=replace-with-mapbox-public-token
NEXT_PUBLIC_POSTER_AI_ENABLED=false

# --- Mobile (Expo) ---
# On a phone, use your computer's LAN IP instead of 127.0.0.1 (e.g. http://192.168.1.20:54321)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
EXPO_PUBLIC_MAPBOX_TOKEN=replace-with-mapbox-public-token

# --- Server-only (Edge Functions / CI). Never expose these to the apps. ---
# SUPABASE_SERVICE_ROLE_KEY=
# MSG91_AUTH_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# ANTHROPIC_API_KEY=
